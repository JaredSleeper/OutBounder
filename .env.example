DATABASE_URL=postgresql://postgres:password@localhost:5435/outbounder
LOG_LEVEL=INFO
PUBLIC_URL=

# Shared password for the hosted draft. Required unless ALLOW_NO_AUTH=true.
APP_PASSWORD=
# Local dev only: run without a password (logs a loud warning). Never enable on a public deployment.
ALLOW_NO_AUTH=false

# Providers. Empty = mock mode (heuristic parsing, no web lookups).
ANTHROPIC_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
# Optional paid email finders; used when set, ignored otherwise.
HUNTER_API_KEY=

# SMTP RCPT probing of candidate addresses (port 25; often blocked on PaaS).
SMTP_VERIFY_ENABLED=true

WORKER_ENABLED=true
WORKER_CONCURRENCY=3
